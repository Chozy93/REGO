<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itwillbs.mapper.CategoryMapper">

    <select id="selectCategoryNameById"
        parameterType="long"
        resultType="string">
    SELECT name
    FROM categories
    WHERE category_id = #{categoryId}
    
</select>

<!-- LIST00_CATEGORY_BAR : 부모 카테고리 기준 자식 조회 -->
    <select id="selectChildrenByParentId"
            parameterType="long"
            resultType="com.itwillbs.dto.CategoryDTO">

        SELECT
            category_id AS categoryId,
            name,
            parent_id AS parentId,
            level
        FROM categories
        WHERE parent_id = #{parentId}
          AND is_active = 1
        ORDER BY sort_order

    </select>


</mapper>
